<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: niente backup cloud né trasferimento device-to-device dei
     dati dell'app (DB Drift, foto degli scontrini, preferenze).
     SECURITY_AUDIT NIP-13. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
